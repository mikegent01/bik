  "chaos_dwarfs_daemon_engine_tune_service": {
    "id": "chaos_dwarfs_daemon_engine_tune_service",
    "name": "Chaos Dwarfs Daemon Engine Tune Service",
    "effects": [
      "Construct +1 attack/damage for 1 day",
      "Risk of chaos mutation"
    ],
    "effectDetails": [
      {
        "title": "Boosted Combat Capability",
        "rules": "When installed in a construct, the engine grants it an additional +1 to its attack and damage rolls for one day. This effect is instantaneous upon activation and lasts until the end of the next long rest."
      },
      {
        "title": "Chaos Mutation Risk",
        "rules": "There is a 20% chance (roll a d6; on a roll of 1-3) that the construct will gain a minor quirk, such as spontaneous singing or an extra arm. The effect lasts until the next long rest and does not require saving."
      }
    ],
    "usage": {
      "activation": "Attuned construct must perform a short rest while the engineer and construct are in contact to activate.",
      "duration": "Instantaneous effect; lasts until next long rest.",
      "endsWhen": "Rest ends when the construct completes its next long rest.",
      "charges": "Unlimited, but requires attunement."
    },
    "aiReviewedAt": "2026-07-22T00:47:13.632766+00:00"
  },
