      "Shield of Sorrow"
    ],
    "effectDetails": [
      {
        "title": "Emotional Resilience",
        "rules": "While wearing one half of the tear, you gain a +2 bonus to saving throws against fear and sadness-related effects. This effect lasts for 1 minute."
      },
