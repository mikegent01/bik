    "id": "mnevis_order_sacred_bull_blessing",
    "name": "Mnevis Order Sacred Bull Blessing",
    "effects": [
      "Bull-like Stubbornness",
      "Immunity to Charm and Fear"
    ],
    "effectDetails": [
