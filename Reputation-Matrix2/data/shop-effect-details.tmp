  "cheep_cheep_aquarium": {
    "id": "cheep_cheep_aquarium",
    "name": "Portable Cheep-Cheep Tank",
    "effects": [
      "Breathe Underwater",
      "Water Jet"
    ],
    "effectDetails": [
      {
        "title": "Breathe Underwater",
        "rules": "While holding this tank, you are considered to be breathing normally underwater. This effect lasts for a short rest and can only be used once per long rest."
      },
      {
        "title": "Water Jet",
        "rules": "As an action, you may command the tank to shoot a jet of water in a 15-foot line. The jet deals 2d6 bludgeoning damage and has a range of 30 feet. Concentration is required while using this effect; if broken or lost, the cheep-cheep becomes hostile."
      }
    ],
    "usage": {
      "activation": "Action or Bonus Action (Water Jet)",
      "duration": "Instantaneous (Water Jet); lasts for a short rest (Breathe Underwater)",
      "endsWhen": "Lost, destroyed, or concentration is broken",
      "charges": "Unlimited, but requires concentration"
    },
    "aiReviewedAt": "2026-07-22T00:48:18.717728+00:00"
  },
