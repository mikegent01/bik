    "effectDetails": [
      {
        "title": "Camouflage",
        "rules": "Activates as a bonus action. Grants temporary camouflage in jungle biomes, allowing the wearer to become invisible to creatures within 30 feet for 5 seconds when they are not moving or attacking."
      },
