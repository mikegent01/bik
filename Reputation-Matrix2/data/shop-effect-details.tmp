  "midlands_mechanical_mage_rod": {
    "id": "midlands_mechanical_mage_rod",
    "name": "Gear of the Iron Oracle",
    "effects": [
      "+10% damage to mechanical enemies",
      "Summons ghostly iron golem for 1 round"
    ],
    "effectDetails": [
