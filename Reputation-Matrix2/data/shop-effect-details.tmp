  "changeling_hive_shapeshift_scarf": {
    "id": "changeling_hive_shapeshift_scarf",
    "name": "Changeling Hive Shapeshift Scarf",
    "effects": [
      "Facial Disguise Aid",
      "Itchy Aftermath"
    ],
    "effectDetails": [
      {
        "title": "Facial Disguise Aid",
        "rules": "You gain advantage on Disguise checks for minor facial alterations when wearing the scarf. This effect is active as long as you are within a short range of at least one ally who can see both you and the target."
      },
      {
        "title": "Itchy Aftermath",
        "rules": "If worn continuously in one place for more than 1 hour, the scarf begins to itch. While it is itching, you have disadvantage on Concentration checks until the scarf is removed or cleaned."
      }
    ],
    "usage": {
      "activation": "Instantaneous; no activation required once worn",
      "duration": "Until removed or destroyed",
      "endsWhen": "Worn continuously for more than 1 hour in one place, or until removed",
      "charges": "Unlimited"
    },
    "aiReviewedAt": "2026-07-22T00:46:42.484774+00:00"
  },
