    ],
    "effectDetails": [
      {
        "title": "Health Surge",
        "rules": "Activates as a bonus action. Grants +50% health regeneration per 5 seconds for up to 1 minute. Ends when the user takes damage, is incapacitated, or uses another effect with similar functionality."
      },
