    "id": "midlands_mechanical_heart",
    "name": "Iron Heart of the Forge",
    "effects": [
      "+15% chance to trigger ‘Gear Up’ on hit (temporary bonus damage)",
      "Temporary resistance to mechanical traps"
    ],
    "effectDetails": [
      {
        "title": "Gear Up",
