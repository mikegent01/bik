  "chaos_dwarfs_hell_bellows": {
    "id": "chaos_dwarfs_hell_bellows",
    "name": "Chaos Dwarfs Hell Bellows",
    "effects": [
      "Chaotic Cooking Advantage",
      "Random Heat (Boon or Bane)"
    ],
    "effectDetails": [
      {
        "title": "Chaotic Cooking Advantage",
        "rules": "When you use the Hell Bellows to fuel a cooking attempt, you gain advantage on the roll. However, if the cooking is intended for an audience or requires precision, there's a 25% chance (DC 14 Dexterity save) that it will go awry."
      },
      {
        "title": "Random Heat (Boon or Bane)",
        "rules": "Each use of the Hell Bellows has a 50% chance to apply either a boon or a bane. A boon could be an unexpected burst of heat, enhancing your dish's quality by +1d4 flavor points; conversely, a bane might cause the food to spoil or become inedible."
      }
    ],
    "usage": {
      "activation": "As an action when starting to cook with charcoal or wood fuel.",
      "duration": "Instantaneous effect; lasts until your next turn.",
      "endsWhen": "The cooking attempt is completed, and it can be used again after a short rest.",
      "charges": "Unlimited uses per long rest"
    },
    "aiReviewedAt": "2026-07-22T00:47:38.882753+00:00"
  },
