  "cheep_cheep_life_preserver": {
    "id": "cheep_cheep_life_preserver",
    "name": "Cheep Cheep Life Preserver",
    "effects": [
      "Cannot Drown",
      "Attracts Aquatic Predators"
    ],
    "effectDetails": [
      {
        "title": "Cannot Drown",
        "rules": "While wearing the Cheep Cheep Life Preserver, you are immune to drowning. You cannot be knocked prone or suffer from suffocation underwater."
      },
      {
        "title": "Attracts Aquatic Predators",
        "rules": "When submerged in water for more than 1 minute, you must make a Wisdom saving throw (DC 12). On a failed save, one hostile fish of your choice within 30 feet appears adjacent to you. This effect can be triggered once per long rest."
      }
    ],
    "usage": {
      "activation": "Passive effect; no activation required.",
      "duration": "Instantaneous; lasts until removed or destroyed.",
      "endsWhen": "Destroyed by damage exceeding your hit points or when removed from you.",
      "charges": "Unlimited, recharged at dawn."
    },
    "aiReviewedAt": "2026-07-22T00:48:35.713416+00:00"
  },
