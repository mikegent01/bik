  "chet_rippo_service": {
    "id": "chet_rippo_service",
    "name": "Stat Reallocation",
    "effects": [
      "Temporarily reallocate 2 stat points",
      "Limited daily use"
    ],
    "effectDetails": [
      {
        "title": "Stat Reallocation",
        "rules": "Activate as an action. You can temporarily transfer two points from any one of your ability scores to another, but you cannot exceed a total of 20 in any stat. This effect lasts for the rest of the day and can be used once per day."
      },
      {
        "title": "Daily Limit",
        "rules": "Once per day at dawn, you may use Pauline's Microphone to reallocate your stats. This is a one-time daily use only."
      }
    ],
    "usage": {
      "activation": "Action",
      "duration": "Until the end of the day",
      "endsWhen": "At dawn the next day",
      "charges": "Daily"
    },
    "aiReviewedAt": "2026-07-22T00:51:11.139248+00:00"
  },
