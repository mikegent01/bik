    ],
    "effectDetails": [
      {
        "title": "Frost Damage Absorption",
        "rules": "When you take frost damage, reduce it by 30%. This effect lasts for the duration of your next short or long rest."
      },
      {
        "title": "Sonic Pulse Disruption",
