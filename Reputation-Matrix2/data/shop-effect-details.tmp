  "chaos_heart_shard": {
    "id": "chaos_heart_shard",
    "name": "Shard of the Chaos Heart",
    "effects": [
      "Chaotic Advantage",
      "Orderly Vulnerability"
    ],
    "effectDetails": [
      {
        "title": "Chaotic Advantage",
        "rules": "When using a spell of the Chaos descriptor, you gain advantage on all attack and damage rolls. This effect lasts until the start of your next turn."
      },
      {
        "title": "Orderly Vulnerability",
        "rules": "For every hour you wield this shard without succumbing to Order's backlash, you must make a DC 17 Constitution saving throw or suffer disadvantage on all saving throws against effects with the Order descriptor. This effect ends when you successfully save."
