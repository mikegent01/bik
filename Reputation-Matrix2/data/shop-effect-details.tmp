  "changeling_hive_chitin_armor": {
    "id": "changeling_hive_chitin_armor",
    "name": "Changeling Hive Chitin Armor",
    "effects": [
      "Shifting Armor: AC 13 + DEX modifier",
      "Social Edge"
    ],
    "effectDetails": [
      {
        "title": "Shifting Armor",
        "rules": "This armor provides the wearer with a +2 bonus to AC. It also has the ability to shift and mold to your form, granting advantage on checks made to impersonate any humanoid creature."
      },
      {
        "title": "Social Edge",
        "rules": "Once per long rest, you can use an action to transform your appearance as if under the effect of a 'Mirror Image' spell, providing temporary protection and distraction for 1 minute. This ability is limited to once every short or long rest."
      }
    ],
    "usage": {
      "activation": "Action or Bonus Action",
      "duration": "1 minute (Social Edge) / Instantaneous (Shifting Armor)",
      "endsWhen": "Ends when the wearer no longer has any hit points. The Social Edge effect ends after 1 minute.",
      "charges": "Unlimited"
    },
    "aiReviewedAt": "2026-07-22T00:46:33.659509+00:00"
  },
