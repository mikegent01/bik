  "changeling_molt_cloak": {
    "id": "changeling_molt_cloak",
    "name": "Changeling Molt Cloak",
    "effects": [
      "Perfect Mimicry",
      "Scent and Texture Capture"
    ],
    "effectDetails": [
      {
        "title": "Perfect Mimicry",
        "rules": "The wearer becomes indistinguishable from the target humanoid for up to 8 hours. This effect requires one hour of concentration to attune to a new target."
      },
      {
        "title": "Scent and Texture Capture",
        "rules": "The cloak captures the scent and texture of the target, making it difficult to distinguish the wearer through touch or smell alone. The mimicry ends if the wearer moves more than 30 feet away from the target or if the target is within 10 feet and actively checks."
      }
    ],
    "usage": {
      "activation": "One hour attunement period to switch targets.",
      "duration": "Up to 8 hours, depending on target and conditions.",
      "endsWhen": "Wearer moves more than 30 feet away from the target or if the target is within 10 feet and actively checks.",
      "charges": "Unlimited uses per day; attunement required for a new target."
    },
    "aiReviewedAt": "2026-07-22T00:46:58.008423+00:00"
  },
