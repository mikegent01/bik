  "chaos_heart": {
    "id": "chaos_heart",
    "name": "The Chaos Heart",
    "effects": [
      "Opens Void rifts (banish enemies to non-existence)",
      "Grants invulnerability when pierced by a Pure Heart"
    ],
    "effectDetails": [
      {
        "title": "Void Rift",
        "rules": "The user can open a rift, banishing one creature of their choice within 30 feet to the Void. The target must succeed on a DC 25 Wisdom saving throw or be sent to a dimension beyond existence, ceasing to exist in the material plane for 1d6 rounds."
      },
      {
        "title": "Invulnerability",
        "rules": "The user gains resistance to all damage from attacks. This effect persists until the user is hit by an attack made with a Pure Heart or similar item that specifically targets this ability, at which point it immediately ends and the user takes full damage."
      }
    ],
    "usage": {
      "activation": "A bonus action to open a rift or use invulnerability.",
      "duration": "Instantaneous for rifts; invulnerability lasts until hit by a piercing attack with a Pure Heart.",
      "endsWhen": "Invulnerability ends when the user is pierced, and the rift closes after 1d6 rounds. The item cannot be used again until recharged through a lengthy ritual.",
      "charges": "Unlimited, but only one use per day."
    },
    "aiReviewedAt": "2026-07-22T00:47:57.369679+00:00"
  },
