  "changeling_hive_recipe_identity_crisis_casserole": {
    "id": "changeling_hive_recipe_identity_crisis_casserole",
    "name": "Recipe: Changeling Hive Identity Crisis Casserole",
    "effects": [
      "Advantage on Deception Checks",
      "Forget Favorite Food"
    ],
    "effectDetails": [
      {
        "title": "Deceptive Advantage",
        "rules": "You gain advantage on all Deception checks for a duration of 1 hour. This effect ends if you use the ability, or when the duration expires."
      },
      {
        "title": "Memory Lapse",
        "rules": "For 24 hours after consuming this dish, you suffer disadvantage on any Intelligence (Investigation) check involving food memory and sensory recall. This effect is permanent until a short rest is taken."
      }
    ],
    "usage": {
      "activation": "Eating the entire casserole during a sitting.",
      "duration": "1 hour for Deceptive Advantage; permanent until a short rest is taken for Memory Lapse.",
      "endsWhen": "The duration ends or you take a short rest, whichever comes first.",
      "charges": "Unlimited uses"
    },
    "aiReviewedAt": "2026-07-22T00:46:33.685784+00:00"
  },
