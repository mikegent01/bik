  "chaos_dwarfs_hellfire_roast_recipe": {
    "id": "chaos_dwarfs_hellfire_roast_recipe",
    "name": "Recipe: Chaos Dwarfs Hellfire Roast",
    "effects": [
      "Teaches recipe: Roast over heat (1 hour); eat to gain random mutation boon (+1 random stat for 2 hours) or bane",
      "Requires: Meat and chaos spices; unpredictable"
    ],
    "effectDetails": [
      {
        "title": "Random Mutation Boon",
        "rules": "Eating the dish grants a +1 increase in a randomly selected ability score for two hours. There is no way to predict which stat will be affected."
      },
      {
        "title": "Random Mutation Bane",
        "rules": "Alternatively, consuming this meal could trigger an unpredictable negative effect, such as a temporary hit point drain or a random ability penalty lasting for the same duration."
      }
    ],
    "usage": {
      "activation": "Cooking and eating the dish",
      "duration": "Instantaneous effect upon consumption; lasts for two hours",
      "endsWhen": "Effect ends after two hours or if the consumer stops benefiting from it early",
      "charges": "Unlimited"
    },
    "aiReviewedAt": "2026-07-22T00:47:38.619109+00:00"
  },
