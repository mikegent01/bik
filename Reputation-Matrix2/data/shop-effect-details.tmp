  "chaos_dwarfs_hellforged_leather": {
    "id": "chaos_dwarfs_hellforged_leather",
    "name": "Chaos Dwarfs Hellforged Leather",
    "effects": [
      "+1 AC vs Fire or Chaos",
      "Resistant to Tearing"
    ],
    "effectDetails": [
      {
        "title": "Heat Resistance",
        "rules": "While wearing this armor, the wearer is immune to the discomfort of moderate heat. However, it emits a steady warmth that can be intolerable in excessively hot climates."
      },
      {
        "title": "Armor Durability",
        "rules": "This leather armor has an innate resistance to tearing and puncturing damage, making it highly durable against sharp weapons."
      }
    ],
    "usage": {
      "activation": "Passive effect",
      "duration": "Instantaneous",
      "endsWhen": "Destroyed by fire or exposed to a chaotic creature's touch",
