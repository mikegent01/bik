  "name:cheep cheep net": {
    "id": "cheep_cheep_net",
    "name": "Cheep Cheep Net",
    "effects": [
      "Aquatic Catcher",
      "Flying Entangler"
    ],
    "effectDetails": [
      {
        "title": "Aquatic Catcher",
        "rules": "The Cheep Cheep Net can be used as a fishing tool. On a successful DC 15 Wisdom (Nature) check, the net catches 1d4 fish per use within reach. This effect is instantaneous."
      },
      {
        "title": "Flying Entangler",
        "rules": "When used against flying creatures or enemies with wings, the Cheep Cheep Net can restrain them for one minute. The target must succeed on a Strength saving throw (DC 15) to escape this effect. This use of the net expends one charge."
      }
    ],
    "usage": {
      "activation": "Action",
      "duration": "Instantaneous (Aquatic Catcher) or one minute (Flying Entangler)",
      "endsWhen": "The target escapes the Flying Entangler effect, or all charges are expended",
      "charges": "5 uses before repair"
    },
    "aiReviewedAt": "2026-07-22T00:48:36.319702+00:00"
  },
  "chomp_call_whistle": {
    "id": "chomp_call_whistle",
    "name": "Chain Chomp Call",
    "effects": [
      "Summons a Chain Chomp",
      "50% chance to attack the user"
    ],
    "effectDetails": [
      {
        "title": "Chain Chomp Summoning",
        "rules": "As an action, you can activate this whistle to summon a CR 2 Chain Chomp. The chomp remains for 1 minute or until it becomes bored and leaves on its own."
      },
      {
        "title": "50% Attack Chance",
        "rules": "There is a 50% chance that the summoned Chain Chomp will attack you instead of moving to your target. This effect lasts for the duration of the chomp's presence."
      }
    ],
    "usage": {
      "activation": "Action",
      "duration": "1 minute per use",
      "endsWhen": "The chomp leaves or becomes bored",
      "charges": "Unlimited uses"
    },
    "aiReviewedAt": "2026-07-22T00:48:46.395487+00:00"
  },
