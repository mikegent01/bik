    {
      "_id": "h7UdiSK9WvEVMPIC",
      "name": "Field Medicine",
      "type": "feat",
      "img": "icons/magic/life/heart-cross-green.webp",
      "system": {
        "description": {
          "value": "<p>Orange T stabilises a creature at 0 hit points as a bonus action, or restores 2d8 + 3 hit points as an action. He treated Bones continuously through a collapsing library with the comfortable familiarity of someone who had been doing it long enough to have a routine, and did not stop to watch the fight happening ten feet away.</p>",
          "chat": ""
        },
