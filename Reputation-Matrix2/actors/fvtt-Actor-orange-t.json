    {
      "_id": "jOLDH35kpzHzzO7f",
      "name": "Banishment",
      "type": "feat",
      "img": "icons/magic/movement/portal-vortex-orange.webp",
      "system": {
        "description": {
          "value": "<p>As an action, Orange T banishes a creature he can see within 60 feet to another plane (CHA save DC 13 negates). He used this on both Dans after treating Bowser's distracted 'not particularly' as consent, casting before the objection could form, and then said 'oh oops'.</p><p><em>Waluigi does not believe the oops.</em></p>",
          "chat": "The spell lands before the objection does."
        },
