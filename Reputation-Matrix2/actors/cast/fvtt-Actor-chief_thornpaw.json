    {
      "_id": "Nz4HXkR1jLCk6qtY",
      "name": "Eighty-Five Years of Narrative",
      "type": "feat",
      "img": "icons/magic/perception/eye-ringed-glow-angry-small-red.webp",
      "system": {
        "description": {
          "value": "<p>Thornpaw has had eighty-five years to decide what the story is. He has advantage on Charisma (Deception) and (Persuasion) checks about the assassination of 955 BF, and Insight checks against him on that subject are made at disadvantage.</p>",
          "chat": ""
        },
        "type": {
