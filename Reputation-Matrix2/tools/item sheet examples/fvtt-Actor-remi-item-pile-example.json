    {
      "_id": "SGwnN0EI7WpRj2ox",
      "name": "Peach's Castle Brick",
      "type": "equipment",
      "img": "icons/containers/bags/coinpouch-simple-leather-brown.webp",
      "system": {
        "description": {
          "value": "<p>This Peach's Castle Brick is a heavy, pink masonry block stamped with the royal crest. Manufactured by Castle Architecture during the Pre-War Era, it serves as a sturdy piece of the kingdom's history.</p><h3>Effects</h3><ul><li><strong>Bludgeoning Projectile</strong>: As an action, you can throw the brick at a target within 20 feet. Make a ranged weapon attack; on a hit, the target takes 1d6 bludgeoning damage.</li><li><strong>Royal Nostalgia</strong>: You have advantage on Wisdom (History) checks made to recall information regarding the kingdom's architecture, lineage, or royal history.</li><li><strong>Heavy and Awkward</strong>: Because of its size and weight, you have disadvantage on attack rolls made with the brick if you are using a ranged attack maneuver or trying to throw it beyond 20 feet.</li></ul><h3>Usage</h3><ul><li><strong>Activation</strong>: Action</li><li><strong>Duration</strong>: Instantaneous</li><li><strong>Ends when</strong>: The brick hits a target or misses and falls to the ground.</li><li><strong>Charges</strong>: Unlimited</li></ul><p>Vendor: wario_land · Shipped by: Rubble Runners · Level requirement: 1</p>",
          "chat": ""
        },
